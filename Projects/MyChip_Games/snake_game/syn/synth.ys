# Area exploration with the ETRI050 std-cell library.
read_verilog -I../rtl ../rtl/snake_top.v ../rtl/snake_body.v ../rtl/game_ctrl.v \
             ../rtl/pixel_gen.v ../rtl/font_rom.v ../rtl/oled_ctrl.v \
             ../rtl/i2c_master.v ../rtl/debounce.v ../rtl/lfsr11.v
hierarchy -top snake_top
synth -top snake_top -flatten
dfflibmap -liberty ../../../../digital_ETRI050_m2f/khu_etri05_stdcells.lib
abc -liberty ../../../../digital_ETRI050_m2f/khu_etri05_stdcells.lib
opt_clean
stat -liberty ../../../../digital_ETRI050_m2f/khu_etri05_stdcells.lib
write_verilog -noattr snake_top_mapped.v
