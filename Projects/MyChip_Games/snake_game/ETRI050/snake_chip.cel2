padgroup Joystick
twpin_JS_UP                     nonfixed
twpin_JS_DOWN                   nonfixed
twpin_JS_LEFT                   nonfixed
twpin_JS_RIGHT                  nonfixed
twpin_JS_OK                     nonfixed
restrict side T

padgroup OLED_I2C
twpin_SCL_OE                    nonfixed
twpin_SDA_OE                    nonfixed
twpin_SDA_I                     nonfixed
twpin_OLED_RES_N                nonfixed
restrict side R

padgroup System
twpin_CLK                       nonfixed
twpin_RST_N                     nonfixed
restrict side B

padgroup Status
twpin_LED                       nonfixed
restrict side L
