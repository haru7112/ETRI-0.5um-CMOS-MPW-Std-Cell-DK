padgroup Joystick permute
twpin_JS_UP                     nonfixed
twpin_JS_DOWN                   nonfixed
twpin_JS_LEFT                   nonfixed
twpin_JS_RIGHT                  nonfixed
twpin_JS_OK                     nonfixed
restrict side T

padgroup OLED_SPI permute
twpin_OLED_SCLK                 nonfixed
twpin_OLED_MOSI                 nonfixed
twpin_OLED_DC                   nonfixed
twpin_OLED_CS_N                 nonfixed
twpin_OLED_RES_N                nonfixed
restrict side R

padgroup System permute
twpin_CLK                       nonfixed
twpin_RST_N                     nonfixed
restrict side B

padgroup Status permute
twpin_LED                       nonfixed
restrict side L
